# Plantilla de configuración. Copiar a `.env` y rellenar la clave del gateway:
#
#     cp .env.example .env
#
# `.env` está en .gitignore. Ninguna variable se lee con os.environ: todo entra
# por `Settings`, y `load_settings()` nombra la que falte al arrancar.
#
# El mapa de roles admite también JSON en una sola variable (`CA_ROLES`). Aquí se
# usan claves anidadas porque cada línea es un hecho editable y revisable en un
# diff; un JSON de seis roles en una línea no se revisa.


# ─────────────────────────────────────── Gateway de modelos ───────────────────────────────────────
# Los seis modelos remotos salen del mismo endpoint compatible con OpenAI.
# `Settings.openai` es una sola credencial y un solo base_url: si algún día un
# modelo pasa a un proveedor directo distinto, hay que mover base_url y clave a
# `ModelChoice`; hoy no cabe en la forma de la configuración.

CA_OPENAI__API_KEY=pon-aqui-tu-clave
CA_OPENAI__BASE_URL=https://pon-aqui-tu-gateway/v1

# Cuánto se espera a una respuesta antes de darla por perdida. Se declara porque
# heredarlo es peor que no tenerlo: sin este valor el SDK de OpenAI aplica 600 s
# de lectura, y un rol colgado retiene diez minutos por intento contra una
# evaluación que completa cuesta ~90 s. El peor rol medido es `bull` con 60 s.
CA_OPENAI__TIMEOUT_SECONDS=120


# ──────────────────────────────────────── Ollama local ────────────────────────────────────────────
# Sirve los respaldos de los tres roles técnicos. Un solo modelo residente:
# qwen3:8b son 5.2 GB sobre ~7.0 GiB libres con el escritorio cargado, así que no
# cabe un segundo modelo local a la vez.
#
# El tag importa más de lo que parece: `qwen3.5:latest` es el mismo nombre en la
# cabeza de cualquiera y son 8.9 GB residentes, que Ollama parte 28%/72% CPU/GPU.
# Comprobar siempre con `ollama ps` tras cambiarlo.

CA_OLLAMA__HOST=http://localhost:11434

# Cuánto mantiene Ollama los pesos cargados tras la última llamada. Su valor por
# defecto son 5 minutos, más corto que cualquier vela que vigile el runner: sin
# esto se recargaría el modelo entero en cada ciclo. Se manda por llamada, no se
# configura en el servidor.
CA_OLLAMA__KEEP_ALIVE=30m

# Ventana de contexto del modelo local. La KV cache crece con este número, y en
# 8 GB es lo primero que empuja capas a la CPU. Comprobar con `ollama ps`: si
# PROCESSOR no dice "100% GPU", este valor es demasiado alto.
CA_OLLAMA__NUM_CTX=4096

# El cliente de Ollama no trae timeout: su httpx sale con Timeout(None), así que
# un servidor colgado no devuelve error, se queda callado y cuelga la corrida sin
# producir una línea. Holgado a propósito: Ollama serializa en la GPU, y los tres
# técnicos del abanico se ejecutan uno detrás de otro.
CA_OLLAMA__TIMEOUT_SECONDS=300


# ────────────────────────────────────────── Exchange ──────────────────────────────────────────────
# Leer mercado y operar son dos clientes distintos, y solo uno quiere claves.
#
# El de lectura va SIEMPRE a producción y SIEMPRE sin credenciales. No es
# configurable, y las dos razones son consecuencias medidas: con las claves
# puestas ccxt firma también los endpoints públicos y binance responde
# `-2008 Invalid Api-Key ID` a una lectura que sin ellas devuelve 500 velas; y
# testnet, como fuente de datos, entrega 58 velas de 4h contra un preset que
# exige 400, así que ninguna evaluación podría completarse nunca.
#
# SANDBOX gobierna por tanto solo el destino de las ÓRDENES, no de dónde salen
# las velas. Las claves se declaran juntas o ninguna, y la ejecución real exige
# además CA_EXECUTION__MODE=live y SANDBOX=false.

CA_EXCHANGE__EXCHANGE_ID=binance
CA_EXCHANGE__SANDBOX=true
# CA_EXCHANGE__API_KEY=
# CA_EXCHANGE__API_SECRET=

CA_EXECUTION__MODE=paper


# ───────────────────────────────────────────── Operación ──────────────────────────────────────────
# Dónde vive el estado operativo. `var/` está en .gitignore: es salida de
# ejecución, no fuente.

CA_OPERATIONS__JOURNAL_PATH=var/journal.jsonl
CA_OPERATIONS__CACHE_DIR=var/cache

# Centinela de parada. Su sola existencia hace que el gate de riesgo vete
# cualquier orden, sin reiniciar nada:
#
#     crypto-agents stop      # lo crea
#     crypto-agents status    # dice si está puesto
#     crypto-agents resume    # lo borra
#
# Un archivo y no una señal: la señal solo alcanza al proceso que la recibe y se
# pierde al reiniciar. Si el archivo no se puede leer, se considera activo — un
# kill switch que falla abierto no es un kill switch.
CA_OPERATIONS__KILL_SWITCH_FILE=var/STOP

# Parada permanente por configuración, independiente del archivo. Basta con que
# una de las dos esté activa.
# CA_RISK__KILL_SWITCH=false


# ──────────────────────────────────────── Bucle de operación ──────────────────────────────────────
# Lo que `crypto-agents run` evalúa. Sin símbolos, el comando se niega a arrancar
# nombrando esta variable en vez de quedarse en silencio.

CA_RUNNER__SYMBOLS=["BTC/USDT","ETH/USDT"]
CA_RUNNER__TIMEFRAME=4h

# Símbolos evaluados a la vez. Uno por defecto: Ollama serializa por GPU, así que
# con cualquier rol degradado a local, dos en paralelo solo hacen cola.
CA_RUNNER__MAX_CONCURRENT=1

# Margen tras el cierre antes de pedir velas. El exchange no publica la vela
# cerrada en el mismo instante del cierre.
CA_RUNNER__SETTLE_SECONDS=5


# ─────────────────────────────────────────────── Cuenta ───────────────────────────────────────────
# Solo la necesitan el gate de riesgo y la ejecución; consultar el journal no.
# En modo live es obligatoria: sin ella, el arranque aborta.
#
# En papel no aborta: hay un valor por defecto silencioso —`NOTIONAL_ACCOUNT` en
# bootstrap.py, 10 000 de equity y de equity inicial del día. Se declaran aquí
# explícitas para que ningún resultado dependa de un número que nadie eligió.
# Todos los tamaños del pipeline son fracciones, así que el nivel absoluto solo
# mueve el veto de drawdown diario.
CA_ACCOUNT__EQUITY=10000
CA_ACCOUNT__DAY_START_EQUITY=10000


# ───────────────────────────────────────── Ventana de cuota ───────────────────────────────────────
# Duración ISO 8601. Por defecto son 5 horas; se declara para que el número que
# acompaña a cada QUOTA_PER_WINDOW esté escrito al lado y no haya que deducirlo.

CA_QUOTA_WINDOW=PT5H


# ──────────────────────────────────────────── Roles ───────────────────────────────────────────────
# Seis familias distintas, una por rol. La restricción dura es solo entre las dos
# mesas (bull y bear no pueden compartir familia), pero la diversidad en los tres
# técnicos es deliberada: tres lecturas del mismo modelo se equivocan igual.
#
# Con los respaldos en qwen3:8b eso deja de ser cierto en el caso degradado: si
# los tres técnicos caen a local, cuatro de los seis roles —los tres técnicos y
# bull— corren sobre familia qwen. Se acepta a ojos abiertos. Está anotado en la
# sección de trampas de CLAUDE.md para que dentro de dos meses no parezca un
# descuido.
#
# MODEL debe ser el identificador exacto del gateway, copiado de su lista de
# modelos. Un id equivocado no falla al cargar la configuración: falla en la
# primera llamada, a mitad de una evaluación ya pagada. `crypto-agents doctor` lo
# contrasta contra `GET {base_url}/models` y sale 1 nombrando rol e id. Los seis
# de abajo salen de esa lista y no llevan prefijo de proveedor: el gateway sirve
# `glm-5.2`, no `zhipu/glm-5.2`.
#
# QUOTA_PER_WINDOW es el presupuesto declarado por el proveedor para esa ventana.
# QUOTA_WEIGHT es lo que consume una llamada: 2.0 en los modelos de doble uso.
#
# En los respaldos locales el valor es un centinela, no una medición: Ollama no
# impone cuota. Lo que limita al local es el throughput —un modelo de 5.2 GB en
# 8 GB de VRAM tarda lo que tarde— y ese límite lo impone el runner, no el
# contador de cuota, que solo modela límites de proveedor.
#
# STRUCTURED_OUTPUT es cómo se le pide el esquema a ese modelo: json_schema,
# json_mode o function_calling. No tiene valor por defecto, y es a propósito. Fue
# durante un tiempo una constante invisible —function_calling, el default de
# LangChain— y con ella la salida de algunos modelos llegaba por un canal que el
# adaptador no leía: el síntoma era una respuesta vacía atribuida al modelo, no a
# la configuración. Cada proveedor soporta un subconjunto distinto y no se puede
# deducir del nombre; `crypto-agents doctor` lo sondea con una llamada mínima por
# rol y sale 1 nombrando el que no funcione, con la línea que hay que escribir.
#
# En los respaldos locales solo cabe json_schema: Ollama restringe la generación
# pasando el esquema en `format` y no expone herramientas. Declarar otra cosa no
# carga.

# ── structure ─ Xiaomi MiMo-V2.5 ──
CA_ROLES__STRUCTURE__PRIMARY__BACKEND=openai
CA_ROLES__STRUCTURE__PRIMARY__MODEL=mimo-v2.5
CA_ROLES__STRUCTURE__PRIMARY__FAMILY=xiaomi
CA_ROLES__STRUCTURE__PRIMARY__STRUCTURED_OUTPUT=json_schema
CA_ROLES__STRUCTURE__PRIMARY__QUOTA_WEIGHT=1.0
CA_ROLES__STRUCTURE__PRIMARY__QUOTA_PER_WINDOW=30100
CA_ROLES__STRUCTURE__FALLBACK__BACKEND=ollama
CA_ROLES__STRUCTURE__FALLBACK__MODEL=qwen3:8b
CA_ROLES__STRUCTURE__FALLBACK__FAMILY=qwen
CA_ROLES__STRUCTURE__FALLBACK__STRUCTURED_OUTPUT=json_schema
CA_ROLES__STRUCTURE__FALLBACK__QUOTA_PER_WINDOW=10000

# ── momentum ─ DeepSeek V4 Flash (doble uso) ──
CA_ROLES__MOMENTUM__PRIMARY__BACKEND=openai
CA_ROLES__MOMENTUM__PRIMARY__MODEL=deepseek-v4-flash
CA_ROLES__MOMENTUM__PRIMARY__FAMILY=deepseek
CA_ROLES__MOMENTUM__PRIMARY__STRUCTURED_OUTPUT=json_schema
CA_ROLES__MOMENTUM__PRIMARY__QUOTA_WEIGHT=2.0
CA_ROLES__MOMENTUM__PRIMARY__QUOTA_PER_WINDOW=63300
CA_ROLES__MOMENTUM__FALLBACK__BACKEND=ollama
CA_ROLES__MOMENTUM__FALLBACK__MODEL=qwen3:8b
CA_ROLES__MOMENTUM__FALLBACK__FAMILY=qwen
CA_ROLES__MOMENTUM__FALLBACK__STRUCTURED_OUTPUT=json_schema
CA_ROLES__MOMENTUM__FALLBACK__QUOTA_PER_WINDOW=10000

# ── volume ─ Tencent Hy3 ──
CA_ROLES__VOLUME__PRIMARY__BACKEND=openai
CA_ROLES__VOLUME__PRIMARY__MODEL=hy3
CA_ROLES__VOLUME__PRIMARY__FAMILY=tencent
CA_ROLES__VOLUME__PRIMARY__STRUCTURED_OUTPUT=json_schema
CA_ROLES__VOLUME__PRIMARY__QUOTA_WEIGHT=1.0
CA_ROLES__VOLUME__PRIMARY__QUOTA_PER_WINDOW=4300
CA_ROLES__VOLUME__FALLBACK__BACKEND=ollama
CA_ROLES__VOLUME__FALLBACK__MODEL=qwen3:8b
CA_ROLES__VOLUME__FALLBACK__FAMILY=qwen
CA_ROLES__VOLUME__FALLBACK__STRUCTURED_OUTPUT=json_schema
CA_ROLES__VOLUME__FALLBACK__QUOTA_PER_WINDOW=10000

# ── bull ─ Kimi K2.6 ──
# Era qwen3.7-plus. La familia qwen entera responde 503 en este gateway —los
# cuatro ids están en el catálogo y ninguno atiende—, así que el sondeo con el
# prompt real dio 0/10 en los tres modos. No es el modo: es el endpoint.
# moonshot es la sexta familia distinta, con lo que los seis roles siguen sin
# repetir familia entre primarios.
#
# QUOTA_PER_WINDOW es una declaración sin verificar: el gateway no publica el
# límite y el sondeo solo dice que responde. Si la ablación empieza a degradar
# aquí, este número es el primero que hay que mirar.
CA_ROLES__BULL__PRIMARY__BACKEND=openai
CA_ROLES__BULL__PRIMARY__MODEL=kimi-k2.6
CA_ROLES__BULL__PRIMARY__FAMILY=moonshot
CA_ROLES__BULL__PRIMARY__STRUCTURED_OUTPUT=json_schema
CA_ROLES__BULL__PRIMARY__QUOTA_WEIGHT=1.0
CA_ROLES__BULL__PRIMARY__QUOTA_PER_WINDOW=4300
# Respaldo local, igual que los tres técnicos. Es lo que hace corrible el brazo
# `local_bull` de la ablación —¿aguanta una mesa en local contra una remota?— y
# no viola nada: la restricción dura es bull != bear, y bear sigue en minimax.
# Ojo con lo que este respaldo NO hace: `resolve()` degrada por cuota agotada,
# nunca por un rechazo de transporte. Con el primario caído, la evaluación
# aborta igual.
CA_ROLES__BULL__FALLBACK__BACKEND=ollama
CA_ROLES__BULL__FALLBACK__MODEL=qwen3:8b
CA_ROLES__BULL__FALLBACK__FAMILY=qwen
CA_ROLES__BULL__FALLBACK__STRUCTURED_OUTPUT=json_schema
CA_ROLES__BULL__FALLBACK__QUOTA_PER_WINDOW=10000

# ── bear ─ MiniMax M3 ──
CA_ROLES__BEAR__PRIMARY__BACKEND=openai
CA_ROLES__BEAR__PRIMARY__MODEL=minimax-m3
CA_ROLES__BEAR__PRIMARY__FAMILY=minimax
CA_ROLES__BEAR__PRIMARY__STRUCTURED_OUTPUT=json_schema
CA_ROLES__BEAR__PRIMARY__QUOTA_WEIGHT=1.0
CA_ROLES__BEAR__PRIMARY__QUOTA_PER_WINDOW=3200

# ── decider ─ GLM-5.2 ──
# Nunca lleva respaldo. Degradar al decisor es cambiar quién toma la decisión
# final sin que quede dicho en ninguna parte; agotada su cuota, el sistema para.
# Es también el rol que fija el techo de evaluaciones por ventana: 880.
CA_ROLES__DECIDER__PRIMARY__BACKEND=openai
CA_ROLES__DECIDER__PRIMARY__MODEL=glm-5.2
CA_ROLES__DECIDER__PRIMARY__FAMILY=zhipu
# Verificado con function_calling: glm-5.2 responde por ahí. Su respuesta vacía
# en la primera corrida fue el modo, no el modelo.
CA_ROLES__DECIDER__PRIMARY__STRUCTURED_OUTPUT=function_calling
CA_ROLES__DECIDER__PRIMARY__QUOTA_WEIGHT=1.0
CA_ROLES__DECIDER__PRIMARY__QUOTA_PER_WINDOW=880
