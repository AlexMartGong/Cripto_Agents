# El entorno de git del servicio. Sin secretos: solo dónde está la clave de despliegue y por dónde
# se sube. Lo lee crypto-agents-forward.service con EnvironmentFile=; los pushes que hagas a mano
# siguen por HTTPS como siempre.
#
# Nada de git pregunta nada: sin terminal no hay nadie que conteste.
GIT_TERMINAL_PROMPT=0
# La clave de despliegue de este repositorio (deploy/README.md, paso 1). git pasa esto por el
# shell, así que ~ es la carpeta del usuario.
GIT_SSH_COMMAND=ssh -i ~/.ssh/cripto_agents_deploy -o IdentitiesOnly=yes -o BatchMode=yes
# Solo el push va por SSH; el pull sigue por HTTPS, sin credencial: el repositorio es público.
GIT_CONFIG_COUNT=1
GIT_CONFIG_KEY_0=remote.origin.pushurl
GIT_CONFIG_VALUE_0=git@github.com:AlexMartGong/Cripto_Agents.git
