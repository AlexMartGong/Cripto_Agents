# Los lotes semanales del estudio hacia adelante, desde el bloque 2. Lo lanza
# crypto-agents-forward.timer; la instalación está en deploy/README.md.
[Unit]
Description=Lotes del estudio hacia adelante de solo (crypto-agents)
Documentation=file://%h/PycharmProjects/Cripto_Agents/deploy/README.md

[Service]
Type=oneshot
WorkingDirectory=%h/PycharmProjects/Cripto_Agents
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/PycharmProjects/Cripto_Agents/deploy/forward.env
# La espera a la red la hace la envoltura (sondeo TCP al remoto, 300 s como máximo): así una
# ejecución sin red deja su línea en var/forward/auto.log y su aviso. network-online.target no
# sirve aquí: es del gestor del sistema y una unidad de usuario no puede esperarlo.
ExecStart=%h/.local/bin/uv run --frozen python -m crypto_agents.forward_service
# Tiempo máximo de la ejecución entera, lotes incluidos: el lote no lleva tiempo propio.
TimeoutStartSec=3h
